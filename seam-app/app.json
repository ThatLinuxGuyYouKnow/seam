{
  "expo": {
    "name": "Seam",
    "slug": "seam",
    "scheme": "seam",
    "version": "1.0.0",
    "description": "Low-bandwidth Cashu and Nostr remittance. Mint Lightning to ecash, send offline, claim on reconnect.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Seam",
      "shortName": "Seam",
      "lang": "en",
      "description": "Low-bandwidth Cashu and Nostr remittance. Mint Lightning to ecash, send offline, claim on reconnect.",
      "themeColor": "#0B0B0F",
      "backgroundColor": "#0B0B0F",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": ".",
      "scope": "."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Seam to scan Cashu QR codes",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
